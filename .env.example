# Non-secret settings; load through your process manager or export explicitly.
PROTON_PUBLIC_HOST=mail.example.com
PROTON_BRIDGE_CERT=/path/to/bridge-cert.pem
PROTON_ACTION_LOG=/path/to/private-actions/actions.jsonl
# Set both for Cloudflare Access; omit both only for trusted localhost use.
ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
ACCESS_AUD=replace-with-application-audience
# Directory containing the private two-line proton-bridge-imap credential file.
# With systemd LoadCredential, systemd supplies this automatically.
CREDENTIALS_DIRECTORY=/path/to/private-credentials

# Batch limits, whole-write deadline and SIGTERM drain budget.
PROTON_IMAP_CHUNK_SIZE=50
PROTON_WRITE_TIMEOUT_SECONDS=120
PROTON_DRAIN_TIMEOUT_SECONDS=60
# Set systemd TimeoutStopSec above the drain budget (for example 75s).

# Fail-closed sender policy. Empty trusted id refuses every body read.
MAIL_ALLOWLIST=/var/lib/proton-mail/policy/allowlist.json
MAIL_TRUSTED_AUTHSERV_ID=
MAIL_ACTIVITY=/var/lib/proton-mail/activity/activity.jsonl
MAIL_HEALTH=/var/lib/proton-mail/health/health.jsonl
# Set only after provisioning the protected shared socket directory and web AUD.
# MAIL_CORE_SOCKET=/run/mail-api/core.sock
# MAIL_WEB_ACCESS_AUD=<separate-web-app-audience>
# ACCESS_JWKS_FILE=/var/lib/mail-access-keys/jwks.json
# MAIL_METRICS_PORT=8789
# Optional: latest aggregate auth-audit counts for the web app (private file).
# MAIL_AUTH_AUDIT_RESULT=/var/lib/proton-mail/audit/result.json
