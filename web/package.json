{
  "name": "mail-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixtures": "MAIL_FIXTURES=1 tsx watch server/dev-fixtures.ts",
    "build": "vite build && tsc --noEmit && npm run build:server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node dist-server/server.js",
    "shell:update": "node scripts/shell-update.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^1.19.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@zsrobinson/shell": "git+https://github.com/zsrobinson/shell.git#54f31cf37df392c3c2d3360befde8e43eaa18bde",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.77.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.2.0"
  }
}
